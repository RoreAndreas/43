# Artefacts de build PyInstaller (ne jamais versionner : très volumineux)
build_exe/
dist/
dist_output/
BackUP/
*.exe
*.spec

# Caches Python
__pycache__/
*.pyc

# Dossier de travail local : jamais versionne (1,3 Go de PDF et de captures)
Downloads/

# Jeu de données lisible, écrit par `build_static.py --keep-data` pour inspection
# locale. Personne ne le lit : la page porte les mêmes chiffres, minifiés.
PFILES/donnees/
